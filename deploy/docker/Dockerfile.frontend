# Stage 1: Build TypeScript/React Frontend
FROM node:22-alpine AS build

WORKDIR /app

COPY 09_dashboard/package.json 09_dashboard/package-lock.json ./
RUN npm ci

COPY 09_dashboard/ ./
RUN npm run build

# Stage 2: Serve with Nginx Reverse Proxy
FROM nginx:alpine

COPY deploy/nginx/sentineltrack.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
