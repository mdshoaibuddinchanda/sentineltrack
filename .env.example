# ==============================================================================
# SentinelTrack Environment Configuration Template
# COPY TO .env AND POPULATE SECRETS. NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Environment & Process Architecture
SENTINEL_ENV=development                         # "development" | "staging" | "production"
SENTINEL_PROCESS_ROLE=all                        # "all" (single node) | "api" (HTTP only) | "analytics" (GPU only)
SENTINEL_ENABLE_STREAM_INGESTION=true            # ingest persisted camera sources in full mode
SENTINEL_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
SENTINEL_HOST=https://cctv.corp8.cloud          # current organizer portal/catalogue host
SENTINEL_ACCESS_PASSWORD=                       # organizer-issued feed password; never commit the real value
SENTINEL_MEDIA_USER_AGENT=Mozilla/5.0 SentinelTrack/1.0  # required by the current authorized HLS CDN
SENTINEL_REFRESH_CATALOGUE_ON_START=true        # refresh camera metadata before workers start
SENTINEL_CATALOGUE_FETCH_ATTEMPTS=3             # bounded transient retry count (1..5)
SENTINEL_STARTUP_TIMEOUT=90                     # parent wait covers catalogue retries (35..180s)
SENTINEL_PREFER_OFFICIAL_HLS=false              # direct RTSP/TCP first for inference; HLS is the remote/browser path
SENTINEL_RTSP_HOST=103.250.160.189              # organizer direct media gateway
SENTINEL_RTSP_PORT=8554
SENTINEL_WHEP_HOST=103.250.160.189               # optional browser WHEP endpoint
SENTINEL_WHEP_PORT=8889

# Approved heterogeneous VMS integrations
# The tracked JSON contains endpoint/secret *references* only. Keep real
# credentials in environment variables or a deployment secret manager.
SENTINEL_VMS_CONNECTOR_CONFIG=configs/vms_connectors.json
# MUNICIPAL_VMS_BEARER_TOKEN=
# TRAFFIC_ONVIF_USERNAME=
# TRAFFIC_ONVIF_PASSWORD=

# Sharding & Multi-Worker Identity
SENTINEL_SHARD_COUNT=1
SENTINEL_SHARD_INDEX=0
SENTINEL_WORKER_ID=worker-0

# PostgreSQL / PostGIS Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sentinel
DATABASE_USER=sentinel
DATABASE_PASSWORD=your_secure_db_password_here

# Database Connection Pool
SENTINEL_DB_POOL_MIN=2
SENTINEL_DB_POOL_MAX=10
SENTINEL_DB_POOL_TIMEOUT=10.0

# Split-Process PostgreSQL LISTEN/NOTIFY Bridge
SENTINEL_PG_EVENT_BRIDGE=false

# Hardware & Model Enforcement
SENTINEL_REQUIRE_GPU=false
SENTINEL_CUDA_FP16=true

# Model Weights Locations
VEHICLE_MODEL_PATH=models/vehicle/yolo11m.pt
PLATE_MODEL_PATH=models/plate/yolo11s_plate_v2.pt

# Fair Scheduling & Adaptive Sampling
SENTINEL_BASE_SAMPLING_FPS=1.0
SENTINEL_BURST_SAMPLING_FPS=5.0
SENTINEL_MAX_STALENESS_MS=1000.0
SENTINEL_QUEUE_MAX_SIZE=10
SENTINEL_BATCH_SIZE=4
SENTINEL_MAX_BATCH_WAIT_MS=10.0

# Streaming Timeouts & Backoff
RTSP_CONNECT_TIMEOUT=10
STREAM_MAX_BACKOFF=30
STREAM_FAILOVER_THRESHOLD=1
STREAM_STALE_AFTER=20
STREAM_RECOVERY_INTERVAL=30

# Initial Admin Bootstrap (Used only on first startup if user table is empty)
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=your_initial_15_char_password_here
